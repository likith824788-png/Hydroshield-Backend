# ─── MongoDB Atlas ─────────────────────────────────────────
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.ihzw74u.mongodb.net/hydroshield?retryWrites=true&w=majority
DATABASE_NAME=hydroshield

# ─── OpenWeather API ───────────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_api_key
